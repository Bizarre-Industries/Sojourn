{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/replan-on-ship.sh",
            "statusMessage": "Checking for unprocessed shipped tags"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/replan-on-ship.sh",
            "statusMessage": "Checking for unprocessed shipped tags"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/replan-on-ship.sh",
            "statusMessage": "Checking for newly shipped tags"
          }
        ]
      }
    ]
  }
}
