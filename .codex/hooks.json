{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/never-guess.sh\"",
            "statusMessage": "Verifying claim is grounded"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/pre-commit-gitleaks.sh\"",
            "statusMessage": "gitleaks pre-commit"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/replan-on-tag.sh\"",
            "statusMessage": "Checking for unprocessed shipped tags"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/replan-on-tag.sh\"",
            "statusMessage": "Checking for unprocessed shipped tags"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.codex/hooks/replan-on-tag.sh\"",
            "statusMessage": "Checking for newly shipped tags"
          }
        ]
      }
    ]
  }
}
