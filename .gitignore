*.secret
*.key
*.pem
jwt.secret
.env
.env.local
.env.*.local

# Misc
coverage.out
*.prof
refs/

# Registry conversion staging (lra/mackup clone)
staging/

# Bundled binaries (downloaded in build phase; tracked via release pipeline)
Sojourn/Resources/bin/gitleaks
Sojourn/Resources/bin/age

