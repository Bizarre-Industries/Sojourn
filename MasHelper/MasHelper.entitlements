<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Helper runs as root via launchd; no App Sandbox.
       get-task-allow forced false so Apple's notary service accepts
       the signed Release binary (matches Sojourn.entitlements). -->
  <key>com.apple.security.get-task-allow</key>
  <false/>
</dict>
</plist>
