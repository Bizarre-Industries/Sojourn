<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleDisplayName</key>
  <string>Sojourn</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>app.bizarre.sojourn</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>Sojourn</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>$(MARKETING_VERSION)</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>SojournDevelopmentTeam</key>
  <string>$(DEVELOPMENT_TEAM)</string>
  <key>LSMinimumSystemVersion</key>
  <string>26.0</string>
  <key>LSUIElement</key>
  <true/>
  <key>NSHumanReadableCopyright</key>
  <string>GPL-3.0-or-later. See LICENSE.</string>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
  <key>ATSApplicationFontsPath</key>
  <string>Fonts</string>
  <key>NSSupportsAutomaticTermination</key>
  <false/>
  <key>NSSupportsSuddenTermination</key>
  <false/>
  <!-- Sparkle 2 — appcast URL + public EdDSA key. Per ADR-0025. -->
  <!-- SUFeedURL targets the GitHub Releases "latest" alias which
       transparently redirects to the most-recent release's
       appcast.xml asset uploaded by .github/workflows/notarize.yml.
       No external CDN dependency. -->
  <key>SUFeedURL</key>
  <string>https://github.com/Bizarre-Industries/Sojourn/releases/latest/download/appcast.xml</string>
  <!-- SUPublicEDKey is the public half of the keypair stored at
       op://Bizarre-Industries/sojourn-sparkle-eddsa. Safe to ship.
       notarize.yml fails the build if this string still equals the
       placeholder at sign time (sojourn-stage-workflow guard). -->
  <key>SUPublicEDKey</key>
  <string>pdBQ5LfVVQpfBNcmpaqHBtPMT0dT75zYxa5GVYevT8M=</string>
  <key>SUEnableAutomaticChecks</key>
  <true/>
  <key>SUScheduledCheckInterval</key>
  <integer>86400</integer>
</dict>
</plist>
